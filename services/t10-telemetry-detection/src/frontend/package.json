{
  "name": "t10-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -p 8110",
    "build": "next build",
    "start": "next start -p 8110",
