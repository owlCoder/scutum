# Kopija ovog fajla je .env (skripta scutum.sh je pravi automatski; .env je u .gitignore).
# Samo razvojne vrednosti. Nikada prave lozinke, tokeni ni sertifikati.
API_PORT=__API_PORT__
DB_PORT_HOST=__DB_PORT__
MYSQL_ROOT_PASSWORD=dev-only-root-change-me
DB_NAME=__ID_LC___db
DB_USER=__ID_LC___app
DB_PASSWORD=dev-only-app-change-me
DB_HOST=__ID_LC__-db
DB_PORT=3306

# Adrese servisa od kojih zavisite. Ime radi i za stub i za pravi servis (oba nose alias <tNN>-api na mreži scutum-net).
# T04_BASE_URL=http://t04-api:8080
